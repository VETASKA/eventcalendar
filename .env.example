# Copy to .env (deploy/install.sh does it for you and fills in the secrets).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=eventcalendar.com.ua,www.eventcalendar.com.ua,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://eventcalendar.com.ua,https://www.eventcalendar.com.ua
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://eventcalendar:change-me@db:5432/eventcalendar
REDIS_URL=redis://redis:6379/0
# Port on the host (Caddy proxies the domain to it; Harvey posts to it)
WEB_PORT=8100
