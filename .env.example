# Copy to .env (deploy/install.sh does it for you and fills in the secrets).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=eventcalendar.com.ua,www.eventcalendar.com.ua,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://eventcalendar.com.ua,https://www.eventcalendar.com.ua
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://eventcalendar:change-me@db:5432/eventcalendar
REDIS_URL=redis://redis:6379/0
# Port on the host (Caddy proxies the domain to it; Harvey posts to it)
WEB_PORT=8100

# Mail: Gmail / Google Workspace. EMAIL_HOST_PASSWORD is an «app password» (Google account → Security →
# 2-Step Verification → App passwords), 16 letters without spaces. Empty = mail is only written to the log.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EventCalendar <calendar@your-domain>

# Telegram bot (later): token from @BotFather, bot name without @, any random string for the webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_SECRET=
