msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: en\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "календар подій"
msgstr "event calendar"

msgid "Мова"
msgstr "Language"

msgid "Кабінет"
msgstr "My account"

msgid "Увійти"
msgstr "Sign in"

msgid "Вийти"
msgstr "Sign out"

msgid "Мої події"
msgstr "My events"

msgid "підтверджено"
msgstr "confirmed"

msgid "Поки немає. Відкрийте свою подію в календарі й натисніть «Це моя подія»."
msgstr "None yet. Open your event in the calendar and click “This is my event”."

msgid "Заявки"
msgstr "Requests"

msgid "надіслано"
msgstr "sent"

msgid "відхилено"
msgstr "rejected"

msgid "прострочено"
msgstr "expired"

msgid "на перевірці"
msgstr "under review"

msgid "Календар подій"
msgstr "Event calendar"

msgid "Календар подій України: конференції, форуми, концерти, стендапи та інше."
msgstr "Events in Ukraine: conferences, forums, concerts, stand-up and more."

msgid "Пошук за назвою"
msgstr "Search by name"

msgid "Пошук за назвою події"
msgstr "Search events by name"

msgid "Знайти…"
msgstr "Find…"

msgid "Знайти"
msgstr "Find"

msgid "Скинути"
msgstr "Reset"

msgid "Показати"
msgstr "Show"

msgid "Запропонувати подію"
msgstr "Suggest an event"

msgid "Події періоду"
msgstr "Events in this period"

msgid "Надішліть посилання — модератор перевірить і додасть подію в календар."
msgstr "Send a link — a moderator will check it and add the event to the calendar."

msgid "Необовʼязково, але допоможе швидше:"
msgstr "Optional, but it helps:"

msgid "Скасувати"
msgstr "Cancel"

msgid "Надіслати"
msgstr "Send"

msgid "Сьогодні"
msgstr "Today"

msgid "Місяць"
msgstr "Month"

msgid "Тиждень"
msgstr "Week"

msgid "Завантаження…"
msgstr "Loading…"

msgid "У цьому періоді поки немає опублікованих подій."
msgstr "No published events in this period yet."

msgid "У цьому періоді немає подій за вашим запитом."
msgstr "No events match your filters in this period."

msgid "Не вдалося завантажити події. Оновіть сторінку."
msgstr "Could not load events. Please reload the page."

msgid "Нічого не знайдено серед майбутніх подій."
msgstr "Nothing found among upcoming events."

msgid "весь день"
msgstr "all day"

msgid "час уточнюється"
msgstr "time to be confirmed"

msgid "скасовано"
msgstr "cancelled"

msgid "подія"
msgstr "event"

msgid "події"
msgstr "events"

msgid "подій"
msgstr "events"

msgid "Це моя подія"
msgstr "This is my event"

msgid "Заявку вже надіслано"
msgstr "Request already sent"

msgid "Розкажіть, хто ви. Модератор перевірить дані, і подія зʼявиться у вашому кабінеті — тоді ви зможете її оновлювати."
msgstr "Tell us who you are. A moderator will check the details, and the event will appear in your account — then you can update it."

msgid "Надіслати заявку"
msgstr "Send request"

msgid "Ви надіслали заявку на «%(t)s» %(d)s. Модератор перевірить її, і подія зʼявиться у вашому кабінеті."
msgstr "You requested “%(t)s” on %(d)s. A moderator will review it and the event will appear in your account."

msgid "До календаря"
msgstr "Back to calendar"

msgid "Мова оригіналу"
msgstr "Original language"

msgid "Коли"
msgstr "When"

msgid "Де"
msgstr "Where"

msgid "Онлайн"
msgstr "Online"

msgid "Ціна"
msgstr "Price"

msgid "Організатор"
msgstr "Organizer"

msgid "Організатор підтверджений"
msgstr "Verified organizer"

msgid "Квитки"
msgstr "Tickets"

msgid "Знайшли помилку?"
msgstr "Found a mistake?"

msgid "Джерело"
msgstr "Source"

msgid "Реєстрація та оплата — на сайті організатора."
msgstr "Registration and payment are on the organizer’s site."

msgid "Напишіть, що не так у картці — модератор перевірить і виправить."
msgstr "Tell us what is wrong — a moderator will check and fix it."

msgid "Сеанс %(n)s"
msgstr "Session %(n)s"

msgid "Вхід"
msgstr "Sign in"

msgid "Кабінет організатора"
msgstr "Organizer account"

msgid "Щоб заявити свою подію, увійдіть або створіть кабінет — це хвилина."
msgstr "To claim your event, sign in or create an account — it takes a minute."

msgid "Створити кабінет"
msgstr "Create account"

msgid "Офлайн"
msgstr "In person"

msgid "Гібрид"
msgstr "Hybrid"

msgid "Скасовано"
msgstr "Cancelled"

msgid "Перенесено, нова дата уточнюється"
msgstr "Postponed, new date to be announced"

msgid "Перенесено"
msgstr "Rescheduled"

msgid "Усі категорії"
msgstr "All categories"

msgid "Усі міста"
msgstr "All cities"

msgid "Будь-який формат"
msgstr "Any format"

msgid "Весь день"
msgstr "All day"

msgid "Час уточнюється"
msgstr "Time to be confirmed"

msgid "Реєстрація та квитки"
msgstr "Registration and tickets"

msgid "Дата або час"
msgstr "Date or time"

msgid "Місце"
msgstr "Place"

msgid "Ціна або квитки"
msgstr "Price or tickets"

msgid "Подію скасовано"
msgstr "Event cancelled"

msgid "Інше"
msgstr "Other"

msgid "Що не так"
msgstr "What is wrong"

msgid "Опишіть, будь ласка"
msgstr "Please describe"

msgid "Наприклад: подію перенесли на 12 березня"
msgstr "For example: the event moved to 12 March"

msgid "Email, якщо хочете відповідь"
msgstr "Email, if you want a reply"

msgid "Ваше імʼя"
msgstr "Your name"

msgid "Email"
msgstr "Email"

msgid "Пароль"
msgstr "Password"

msgid "Не менше 10 символів"
msgstr "At least 10 characters"

msgid "Цей email уже зареєстровано. Увійдіть."
msgstr "This email is already registered. Please sign in."

msgid "Організація або бренд"
msgstr "Organization or brand"

msgid "Ваша роль"
msgstr "Your role"

msgid "Наприклад: організатор, менеджер, PR"
msgstr "For example: organizer, manager, PR"

msgid "Телефон для звʼязку"
msgstr "Contact phone"

msgid "Чим можете підтвердити"
msgstr "How can you prove it"

msgid "Посилання на сторінку, де вас вказано, пошта на домені організатора, соцмережі події — усе, що допоможе модератору."
msgstr "A page that lists you, an email on the organizer’s domain, the event’s social media — anything that helps the moderator."

msgid "Посилання на подію"
msgstr "Link to the event"

msgid "Ваш email"
msgstr "Your email"

msgid "Якщо хочете дізнатися, коли подію опублікують"
msgstr "If you want to know when it is published"

msgid "Дата"
msgstr "Date"

msgid "Місто"
msgstr "City"

msgid "Категорія"
msgstr "Category"

msgid "Дякуємо! Повідомлення надіслано модератору."
msgstr "Thank you! Your message has been sent to a moderator."

msgid "Забагато повідомлень. Спробуйте пізніше."
msgstr "Too many messages. Please try later."

msgid "Опишіть, будь ласка, що саме не так."
msgstr "Please describe what exactly is wrong."

msgid "Забагато спроб входу. Спробуйте за годину."
msgstr "Too many sign-in attempts. Try again in an hour."

msgid "Невірний email або пароль."
msgstr "Wrong email or password."

msgid "Забагато реєстрацій з цієї адреси. Спробуйте пізніше."
msgstr "Too many sign-ups from this address. Please try later."

msgid "Кабінет створено."
msgstr "Your account has been created."

msgid "Ця подія вже у вашому кабінеті."
msgstr "This event is already in your account."

msgid "Забагато заявок. Спробуйте пізніше."
msgstr "Too many requests. Please try later."

msgid "Заявку надіслано. Модератор перевірить її і відповість у кабінеті."
msgstr "Request sent. A moderator will review it and reply in your account."

msgid "Дякуємо! Подію надіслано на перевірку."
msgstr "Thank you! The event has been sent for review."

msgid "Забагато пропозицій. Спробуйте пізніше."
msgstr "Too many suggestions. Please try later."

msgid "Вкажіть, будь ласка, коректне посилання на подію."
msgstr "Please give a valid link to the event."

msgid "Ця подія вже є в календарі."
msgstr "This event is already in the calendar."

msgid "Дякуємо! Ця подія вже є у нас і чекає на перевірку."
msgstr "Thank you! We already have this event and it is awaiting review."

msgid "Дякуємо! Подію надіслано на перевірку — після модерації вона зʼявиться в календарі."
msgstr "Thank you! The event has been sent for review — it will appear in the calendar after moderation."

msgid "ще {n}"
msgstr "+{n} more"

msgid "Ще {n} — уточніть запит."
msgstr "{n} more — refine your search."

msgid "Підтвердіть email — посилання в листі. Без цього не можна заявити подію."
msgstr "Please confirm your email — the link is in the letter. You need it to claim an event."

msgid "Надіслати лист ще раз"
msgstr "Send the letter again"

msgid "зміни на перевірці"
msgstr "changes under review"

msgid "Редагувати"
msgstr "Edit"

msgid "сайт підтверджено"
msgstr "site confirmed"

msgid "Контроль над сайтом підтверджено. Модератор видасть права найближчим часом — подія зʼявиться в кабінеті."
msgstr "Control of the site is confirmed. A moderator will grant access soon — the event will appear in your account."

msgid "Заявку відхилено."
msgstr "The request was rejected."

msgid "Термін дії коду минув. Створіть заявку ще раз."
msgstr "The code has expired. Please create a new request."

msgid "Він має відкриватися за адресою:"
msgstr "It must open at:"

msgid "Натисніть «Перевірити». Код дійсний 7 днів і працює лише для цієї заявки."
msgstr "Click “Check”. The code is valid for 7 days and only for this request."

msgid "Перевірити"
msgstr "Check"

msgid "Немає доступу до сайту? Модератор перевірить заявку вручну — просто зачекайте."
msgstr "No access to the site? A moderator will check the request manually — just wait."

msgid "Надіслати посилання"
msgstr "Send link"

msgid "Модератор перевірить вашу заявку вручну і може звʼязатися з вами за вказаним телефоном."
msgstr "A moderator will check your request manually and may call you on the phone you gave."

msgid "Створіть на сайті події файл %(f)s з таким рядком:"
msgstr "Create the file %(f)s on the event’s site with this line:"

msgid "Вкажіть адресу на домені %(h)s — ми надішлемо на неї одноразове посилання. Публічні скриньки (Gmail, Ukr.net тощо) не підходять."
msgstr "Give an address on %(h)s — we will send a one-time link to it. Public mailboxes (Gmail, Ukr.net etc.) are not accepted."

msgid "Редагувати подію"
msgstr "Edit event"

msgid "Зміни зʼявляться на сайті після перевірки модератором. Перенесення та скасування — розглядаються першими."
msgstr "Changes appear on the site after a moderator checks them. Reschedules and cancellations are reviewed first."

msgid "Попередні зміни ще на перевірці. Нові замінять їх."
msgstr "Your previous changes are still under review. New ones will replace them."

msgid "Дати й місце"
msgstr "Dates and place"

msgid "Додати сеанс"
msgstr "Add a session"

msgid "Видалити цей сеанс"
msgstr "Delete this session"

msgid "Надіслати на перевірку"
msgstr "Send for review"

msgid "Забули пароль?"
msgstr "Forgot your password?"

msgid "Відновлення пароля"
msgstr "Password reset"

msgid "Вкажіть email кабінету — надішлемо посилання для нового пароля."
msgstr "Enter your account email — we will send a link to set a new password."

msgid "Новий пароль"
msgstr "New password"

msgid "Пароль змінено"
msgstr "Password changed"

msgid "Зберегти пароль"
msgstr "Save password"

msgid "Посилання недійсне"
msgstr "Link not valid"

msgid "Воно вже використане або застаріло."
msgstr "It has been used or has expired."

msgid "Надіслати нове"
msgstr "Send a new one"

msgid "Перевірте пошту"
msgstr "Check your email"

msgid "Якщо такий кабінет існує, ми надіслали лист із посиланням. Воно діє 3 дні."
msgstr "If such an account exists, we have sent a letter with a link. It is valid for 3 days."

msgid "Кабінет створено. Ми надіслали лист — підтвердіть email за посиланням."
msgstr "Account created. We sent you a letter — please confirm your email with the link."

msgid "Спочатку підтвердіть свій email — лист у пошті, або надішліть його ще раз у кабінеті."
msgstr "Please confirm your email first — the letter is in your inbox, or send it again from your account."

msgid "Забагато перевірок. Спробуйте пізніше."
msgstr "Too many checks. Please try later."

msgid "Сайт підтверджено. Модератор видасть права найближчим часом."
msgstr "Site confirmed. A moderator will grant access soon."

msgid "Файл знайдено на іншому сайті. Він має бути на сайті самої події."
msgstr "The file was found on another site. It must be on the event’s own site."

msgid "Файл знайдено, але код у ньому не збігається."
msgstr "The file was found, but the code in it does not match."

msgid "Файл не знайдено. Перевірте адресу й спробуйте ще раз за хвилину."
msgstr "File not found. Check the address and try again in a minute."

msgid "Забагато листів. Спробуйте пізніше."
msgstr "Too many letters. Please try later."

msgid "Потрібна адреса на домені сайту події, не публічна пошта."
msgstr "An address on the event site’s domain is needed, not a public mailbox."

msgid "Адреса має бути на домені %(host)s."
msgstr "The address must be on %(host)s."

msgid "Лист надіслано. Відкрийте його й перейдіть за посиланням протягом доби."
msgstr "Letter sent. Open it and follow the link within 24 hours."

msgid "Посилання недійсне або вже використане."
msgstr "The link is not valid or has already been used."

msgid "Пошту підтверджено. Модератор видасть права найближчим часом."
msgstr "Email confirmed. A moderator will grant access soon."

msgid "Посилання недійсне або застаріле. Надішліть лист ще раз у кабінеті."
msgstr "The link is not valid or has expired. Send the letter again from your account."

msgid "Email підтверджено."
msgstr "Email confirmed."

msgid "Лист надіслано ще раз."
msgstr "The letter has been sent again."

msgid "Змін немає."
msgstr "No changes."

msgid "Зміни надіслано на модерацію. Після перевірки вони зʼявляться на сайті."
msgstr "Changes sent for moderation. They will appear on the site after review."

msgid "Забагато запитів. Спробуйте пізніше."
msgstr "Too many requests. Please try later."

msgid "Як підтвердите, що подія ваша"
msgstr "How will you prove the event is yours"

msgid "Файл на сайті події — найшвидше"
msgstr "A file on the event’s site — the fastest"

msgid "Лист на пошту з домену сайту події"
msgstr "A letter to an address on the event site’s domain"

msgid "Перевірка модератором вручну"
msgstr "Manual check by a moderator"

msgid "Пошта на домені сайту події"
msgstr "Email on the event site’s domain"

msgid "Назва"
msgstr "Name"

msgid "Короткий анонс"
msgstr "Short description"

msgid "1–3 речення своїми словами"
msgstr "1–3 sentences in your own words"

msgid "Формат"
msgstr "Format"

msgid "Посилання на реєстрацію або квитки"
msgstr "Registration or tickets link"

msgid "До (якщо кілька днів)"
msgstr "Until (if several days)"

msgid "Початок"
msgstr "Starts"

msgid "Кінець"
msgstr "Ends"

msgid "Місце проведення"
msgstr "Venue"

msgid "Статус"
msgstr "Status"

msgid "За планом"
msgstr "As planned"

msgid "Видалити"
msgstr "Delete"

msgid "Дата закінчення раніше за початок."
msgstr "The end date is before the start."

msgid "Подію додано у ваш кабінет"
msgstr "The event has been added to your account"

msgid "Заявку відхилено"
msgstr "Request rejected"

msgid "Кабінет:"
msgstr "Your account:"

msgid "Тепер ви можете оновлювати подію «%(t)s» у кабінеті."
msgstr "You can now update “%(t)s” from your account."

msgid "Не вдалося підтвердити, що подія «%(t)s» ваша."
msgstr "We could not confirm that “%(t)s” is your event."

msgid "Підтвердження: це ваша подія?"
msgstr "Confirmation: is this your event?"

msgid "Якщо це ви — відкрийте посилання (діє 24 години, працює один раз):"
msgstr "If it was you, open the link (valid for 24 hours, works once):"

msgid "Якщо ні — нічого не робіть, права ніхто не отримає."
msgstr "If not, do nothing — nobody will get access."

msgid "Хтось вказав цю адресу, щоб підтвердити, що подія «%(t)s» належить вашій організації."
msgstr "Someone gave this address to confirm that “%(t)s” belongs to your organization."

msgid "Щоб задати новий пароль, відкрийте посилання (діє 3 дні):"
msgstr "To set a new password, open the link (valid for 3 days):"

msgid "Якщо ви не просили змінити пароль — просто проігноруйте цей лист."
msgstr "If you did not ask to change your password, just ignore this letter."

msgid "Новий пароль для EventCalendar"
msgstr "New password for EventCalendar"

msgid "Ваші зміни опубліковано"
msgstr "Your changes are published"

msgid "Ваші зміни не прийнято"
msgstr "Your changes were not accepted"

msgid "Зміни до події «%(t)s» перевірено й опубліковано."
msgstr "The changes to “%(t)s” have been checked and published."

msgid "Модератор не прийняв зміни до події «%(t)s»."
msgstr "A moderator did not accept the changes to “%(t)s”."

msgid "Підтвердіть email у EventCalendar"
msgstr "Confirm your email at EventCalendar"

msgid "Щоб підтвердити адресу, відкрийте посилання (діє 3 дні):"
msgstr "To confirm your address, open the link (valid for 3 days):"

msgid "Якщо ви не реєструвалися — просто проігноруйте цей лист."
msgstr "If you did not sign up, just ignore this letter."

msgid "Вітаємо, %(n)s!"
msgstr "Hello, %(n)s!"

msgid "Підписатися"
msgstr "Subscribe"

msgid "Нові події щовівторка"
msgstr "New events every Tuesday"

msgid "Раз на тиждень — лише нові події за вашим вибором. Відписатися — одним кліком у кожному листі."
msgstr "Once a week — only new events you chose. Unsubscribe with one click in any email."

msgid "Міста"
msgstr "Cities"

msgid "(нічого не обрано — усі)"
msgstr "(nothing selected — all)"

msgid "Категорії"
msgstr "Categories"

msgid "Нагадати за добу"
msgstr "Remind me a day before"

msgid "Сеанс"
msgstr "Session"

msgid "Нагадати"
msgstr "Remind me"

msgid "Відписатися"
msgstr "Unsubscribe"

msgid "Відписатися від розсилки?"
msgstr "Unsubscribe from the mailing list?"

msgid "Так, відписатися"
msgstr "Yes, unsubscribe"

msgid "Ви відписалися"
msgstr "You have unsubscribed"

msgid "Листів більше не буде. Підписатися знову можна на головній сторінці."
msgstr "No more emails. You can subscribe again on the home page."

msgid "Вкажіть email."
msgstr "Enter your email."

msgid "Забагато спроб. Спробуйте пізніше."
msgstr "Too many attempts. Try again later."

msgid "Перевірте email і спробуйте ще раз."
msgstr "Check your email address and try again."

msgid "Підписка в Telegram зʼявиться найближчим часом."
msgstr "Telegram subscription is coming soon."

msgid "Майже готово: відкрийте лист і підтвердіть підписку."
msgstr "Almost done: open the email and confirm your subscription."

msgid "Посилання недійсне або застаріле."
msgstr "The link is invalid or expired."

msgid "Підписку підтверджено."
msgstr "Subscription confirmed."

msgid "Email підтверджено — нагадаємо за добу до події."
msgstr "Email confirmed — we'll remind you a day before the event."

msgid "До події менше доби — нагадування вже не встигне."
msgstr "The event is less than a day away — too late for a reminder."

msgid "Нагадаємо за добу до події."
msgstr "We'll remind you a day before the event."

msgid "Підтвердіть email у листі — і ми нагадаємо за добу до події."
msgstr "Confirm your email in the message we sent, and we'll remind you a day before the event."

msgid "Нова дата:"
msgstr "New date:"

msgid "Нагадування перенесено разом із подією."
msgstr "Your reminder has moved with the event."

msgid "Відписатися:"
msgstr "Unsubscribe:"

msgid "Скасовано: %(t)s"
msgstr "Cancelled: %(t)s"

msgid "Змінено дату: %(t)s"
msgstr "Date changed: %(t)s"

msgid "Подію «%(t)s», про яку ви просили нагадати, скасовано."
msgstr "The event “%(t)s” you asked to be reminded about has been cancelled."

msgid "Подію «%(t)s», про яку ви просили нагадати, перенесено."
msgstr "The event “%(t)s” you asked to be reminded about has been rescheduled."

msgid "Нові події за вашим вибором:"
msgstr "New events matching your choice:"

msgid "Ви отримали цей лист, бо підписалися на календар подій."
msgstr "You received this email because you subscribed to the event calendar."

msgid "…та ще %(more)s на сайті"
msgstr "…and %(more)s more on the site"

msgid "Нові події в календарі: %(n)s"
msgstr "New events in the calendar: %(n)s"

msgid "Завтра: %(t)s"
msgstr "Tomorrow: %(t)s"

msgid "Нагадуємо: «%(t)s» вже завтра."
msgstr "Reminder: “%(t)s” is tomorrow."

msgid "Підтвердіть email для нагадування"
msgstr "Confirm your email for the reminder"

msgid "Підтвердіть підписку на календар подій"
msgstr "Confirm your event calendar subscription"

msgid "Щоб отримати нагадування за добу до події, підтвердіть адресу:"
msgstr "To get a reminder a day before the event, confirm your address:"

msgid "Щовівторка надсилатимемо нові події за вашим вибором."
msgstr "Every Tuesday we'll send new events matching your choice."

msgid "Ваш вибір:"
msgstr "Your choice:"

msgid "Підтвердіть підписку (посилання діє 7 днів):"
msgstr "Confirm your subscription (the link is valid for 7 days):"

msgid "Якщо це були не ви — просто проігноруйте лист."
msgstr "If this wasn't you, just ignore this email."
