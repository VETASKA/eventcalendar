msgid "календар подій"
msgstr "kalendarz wydarzeń"

msgid "Мова"
msgstr "Język"

msgid "Кабінет"
msgstr "Moje konto"

msgid "Увійти"
msgstr "Zaloguj się"

msgid "Вийти"
msgstr "Wyloguj się"

msgid "Мої події"
msgstr "Moje wydarzenia"

msgid "підтверджено"
msgstr "potwierdzone"

msgid "Поки немає. Відкрийте свою подію в календарі й натисніть «Це моя подія»."
msgstr "Na razie brak. Otwórz swoje wydarzenie w kalendarzu i kliknij „To moje wydarzenie”."

msgid "Заявки"
msgstr "Wnioski"

msgid "надіслано"
msgstr "wysłano"

msgid "відхилено"
msgstr "odrzucono"

msgid "прострочено"
msgstr "wygasło"

msgid "на перевірці"
msgstr "w weryfikacji"

msgid "Календар подій"
msgstr "Kalendarz wydarzeń"

msgid "Календар подій України: конференції, форуми, концерти, стендапи та інше."
msgstr "Wydarzenia w Ukrainie: konferencje, fora, koncerty, stand-up i więcej."

msgid "Пошук за назвою"
msgstr "Szukaj po nazwie"

msgid "Пошук за назвою події"
msgstr "Szukaj wydarzeń po nazwie"

msgid "Знайти…"
msgstr "Znajdź…"

msgid "Знайти"
msgstr "Znajdź"

msgid "Скинути"
msgstr "Wyczyść"

msgid "Показати"
msgstr "Pokaż"

msgid "Запропонувати подію"
msgstr "Zaproponuj wydarzenie"

msgid "Події періоду"
msgstr "Wydarzenia w tym okresie"

msgid "Надішліть посилання — модератор перевірить і додасть подію в календар."
msgstr "Wyślij link — moderator sprawdzi go i doda wydarzenie do kalendarza."

msgid "Необовʼязково, але допоможе швидше:"
msgstr "Opcjonalnie, ale przyspieszy weryfikację:"

msgid "Скасувати"
msgstr "Anuluj"

msgid "Надіслати"
msgstr "Wyślij"

msgid "Сьогодні"
msgstr "Dziś"

msgid "Місяць"
msgstr "Miesiąc"

msgid "Тиждень"
msgstr "Tydzień"

msgid "Завантаження…"
msgstr "Ładowanie…"

msgid "У цьому періоді поки немає опублікованих подій."
msgstr "W tym okresie nie ma jeszcze opublikowanych wydarzeń."

msgid "У цьому періоді немає подій за вашим запитом."
msgstr "Brak wydarzeń pasujących do filtrów w tym okresie."

msgid "Не вдалося завантажити події. Оновіть сторінку."
msgstr "Nie udało się wczytać wydarzeń. Odśwież stronę."

msgid "Нічого не знайдено серед майбутніх подій."
msgstr "Nic nie znaleziono wśród nadchodzących wydarzeń."

msgid "весь день"
msgstr "cały dzień"

msgid "час уточнюється"
msgstr "godzina do potwierdzenia"

msgid "скасовано"
msgstr "odwołane"

msgid "подія"
msgstr "wydarzenie"

msgid "події"
msgstr "wydarzenia"

msgid "подій"
msgstr "wydarzeń"

msgid "Це моя подія"
msgstr "To moje wydarzenie"

msgid "Заявку вже надіслано"
msgstr "Wniosek już wysłany"

msgid "Розкажіть, хто ви. Модератор перевірить дані, і подія зʼявиться у вашому кабінеті — тоді ви зможете її оновлювати."
msgstr "Powiedz nam, kim jesteś. Moderator sprawdzi dane, a wydarzenie pojawi się na Twoim koncie — wtedy będzie można je aktualizować."

msgid "Надіслати заявку"
msgstr "Wyślij wniosek"

msgid "Ви надіслали заявку на «%(t)s» %(d)s. Модератор перевірить її, і подія зʼявиться у вашому кабінеті."
msgstr "Wysłano wniosek dotyczący „%(t)s” %(d)s. Moderator go sprawdzi, a wydarzenie pojawi się na Twoim koncie."

msgid "До календаря"
msgstr "Do kalendarza"

msgid "Мова оригіналу"
msgstr "Język oryginału"

msgid "Коли"
msgstr "Kiedy"

msgid "Де"
msgstr "Gdzie"

msgid "Онлайн"
msgstr "Online"

msgid "Ціна"
msgstr "Cena"

msgid "Організатор"
msgstr "Organizator"

msgid "Організатор підтверджений"
msgstr "Zweryfikowany organizator"

msgid "Квитки"
msgstr "Bilety"

msgid "Знайшли помилку?"
msgstr "Znalazłeś błąd?"

msgid "Джерело"
msgstr "Źródło"

msgid "Реєстрація та оплата — на сайті організатора."
msgstr "Rejestracja i płatność — na stronie organizatora."

msgid "Напишіть, що не так у картці — модератор перевірить і виправить."
msgstr "Napisz, co jest nie tak — moderator sprawdzi i poprawi."

msgid "Сеанс %(n)s"
msgstr "Termin %(n)s"

msgid "Вхід"
msgstr "Logowanie"

msgid "Кабінет організатора"
msgstr "Konto organizatora"

msgid "Щоб заявити свою подію, увійдіть або створіть кабінет — це хвилина."
msgstr "Aby zgłosić swoje wydarzenie, zaloguj się lub załóż konto — to zajmie minutę."

msgid "Створити кабінет"
msgstr "Załóż konto"

msgid "Офлайн"
msgstr "Stacjonarnie"

msgid "Гібрид"
msgstr "Hybrydowo"

msgid "Скасовано"
msgstr "Odwołane"

msgid "Перенесено, нова дата уточнюється"
msgstr "Przełożone, nowa data wkrótce"

msgid "Перенесено"
msgstr "Przeniesione"

msgid "Усі категорії"
msgstr "Wszystkie kategorie"

msgid "Усі міста"
msgstr "Wszystkie miasta"

msgid "Будь-який формат"
msgstr "Dowolny format"

msgid "Весь день"
msgstr "Cały dzień"

msgid "Час уточнюється"
msgstr "Godzina do potwierdzenia"

msgid "Реєстрація та квитки"
msgstr "Rejestracja i bilety"

msgid "Дата або час"
msgstr "Data lub godzina"

msgid "Місце"
msgstr "Miejsce"

msgid "Ціна або квитки"
msgstr "Cena lub bilety"

msgid "Подію скасовано"
msgstr "Wydarzenie odwołane"

msgid "Інше"
msgstr "Inne"

msgid "Що не так"
msgstr "Co jest nie tak"

msgid "Опишіть, будь ласка"
msgstr "Opisz, proszę"

msgid "Наприклад: подію перенесли на 12 березня"
msgstr "Na przykład: wydarzenie przeniesiono na 12 marca"

msgid "Email, якщо хочете відповідь"
msgstr "E-mail, jeśli chcesz odpowiedź"

msgid "Ваше імʼя"
msgstr "Imię"

msgid "Email"
msgstr "E-mail"

msgid "Пароль"
msgstr "Hasło"

msgid "Не менше 10 символів"
msgstr "Co najmniej 10 znaków"

msgid "Цей email уже зареєстровано. Увійдіть."
msgstr "Ten e-mail jest już zarejestrowany. Zaloguj się."

msgid "Організація або бренд"
msgstr "Organizacja lub marka"

msgid "Ваша роль"
msgstr "Twoja rola"

msgid "Наприклад: організатор, менеджер, PR"
msgstr "Na przykład: organizator, menedżer, PR"

msgid "Телефон для звʼязку"
msgstr "Telefon kontaktowy"

msgid "Чим можете підтвердити"
msgstr "Czym możesz to potwierdzić"

msgid "Посилання на сторінку, де вас вказано, пошта на домені організатора, соцмережі події — усе, що допоможе модератору."
msgstr "Strona, na której jesteś wymieniony, e-mail w domenie organizatora, media społecznościowe wydarzenia — wszystko, co pomoże moderatorowi."

msgid "Посилання на подію"
msgstr "Link do wydarzenia"

msgid "Ваш email"
msgstr "Twój e-mail"

msgid "Якщо хочете дізнатися, коли подію опублікують"
msgstr "Jeśli chcesz wiedzieć, kiedy zostanie opublikowane"

msgid "Дата"
msgstr "Data"

msgid "Місто"
msgstr "Miasto"

msgid "Категорія"
msgstr "Kategoria"

msgid "Дякуємо! Повідомлення надіслано модератору."
msgstr "Dziękujemy! Wiadomość została wysłana do moderatora."

msgid "Забагато повідомлень. Спробуйте пізніше."
msgstr "Zbyt wiele wiadomości. Spróbuj później."

msgid "Опишіть, будь ласка, що саме не так."
msgstr "Opisz, proszę, co dokładnie jest nie tak."

msgid "Забагато спроб входу. Спробуйте за годину."
msgstr "Zbyt wiele prób logowania. Spróbuj za godzinę."

msgid "Невірний email або пароль."
msgstr "Nieprawidłowy e-mail lub hasło."

msgid "Забагато реєстрацій з цієї адреси. Спробуйте пізніше."
msgstr "Zbyt wiele rejestracji z tego adresu. Spróbuj później."

msgid "Кабінет створено."
msgstr "Konto zostało utworzone."

msgid "Ця подія вже у вашому кабінеті."
msgstr "To wydarzenie jest już na Twoim koncie."

msgid "Забагато заявок. Спробуйте пізніше."
msgstr "Zbyt wiele wniosków. Spróbuj później."

msgid "Заявку надіслано. Модератор перевірить її і відповість у кабінеті."
msgstr "Wniosek wysłany. Moderator go sprawdzi i odpowie na Twoim koncie."

msgid "Дякуємо! Подію надіслано на перевірку."
msgstr "Dziękujemy! Wydarzenie zostało wysłane do weryfikacji."

msgid "Забагато пропозицій. Спробуйте пізніше."
msgstr "Zbyt wiele propozycji. Spróbuj później."

msgid "Вкажіть, будь ласка, коректне посилання на подію."
msgstr "Podaj, proszę, prawidłowy link do wydarzenia."

msgid "Ця подія вже є в календарі."
msgstr "To wydarzenie jest już w kalendarzu."

msgid "Дякуємо! Ця подія вже є у нас і чекає на перевірку."
msgstr "Dziękujemy! To wydarzenie już mamy i czeka na weryfikację."

msgid "Дякуємо! Подію надіслано на перевірку — після модерації вона зʼявиться в календарі."
msgstr "Dziękujemy! Wydarzenie wysłano do weryfikacji — pojawi się w kalendarzu po moderacji."

msgid "ще {n}"
msgstr "+{n} więcej"

msgid "Ще {n} — уточніть запит."
msgstr "Jeszcze {n} — doprecyzuj wyszukiwanie."

msgid "Підтвердіть email — посилання в листі. Без цього не можна заявити подію."
msgstr "Potwierdź e-mail — link jest w wiadomości. Bez tego nie można zgłosić wydarzenia."

msgid "Надіслати лист ще раз"
msgstr "Wyślij wiadomość ponownie"

msgid "зміни на перевірці"
msgstr "zmiany w weryfikacji"

msgid "Редагувати"
msgstr "Edytuj"

msgid "сайт підтверджено"
msgstr "strona potwierdzona"

msgid "Контроль над сайтом підтверджено. Модератор видасть права найближчим часом — подія зʼявиться в кабінеті."
msgstr "Kontrola nad stroną potwierdzona. Moderator wkrótce nada uprawnienia — wydarzenie pojawi się na koncie."

msgid "Заявку відхилено."
msgstr "Wniosek odrzucono."

msgid "Термін дії коду минув. Створіть заявку ще раз."
msgstr "Kod wygasł. Utwórz nowy wniosek."

msgid "Він має відкриватися за адресою:"
msgstr "Musi otwierać się pod adresem:"

msgid "Натисніть «Перевірити». Код дійсний 7 днів і працює лише для цієї заявки."
msgstr "Kliknij „Sprawdź”. Kod jest ważny 7 dni i tylko dla tego wniosku."

msgid "Перевірити"
msgstr "Sprawdź"

msgid "Немає доступу до сайту? Модератор перевірить заявку вручну — просто зачекайте."
msgstr "Brak dostępu do strony? Moderator sprawdzi wniosek ręcznie — wystarczy poczekać."

msgid "Надіслати посилання"
msgstr "Wyślij link"

msgid "Модератор перевірить вашу заявку вручну і може звʼязатися з вами за вказаним телефоном."
msgstr "Moderator sprawdzi wniosek ręcznie i może zadzwonić pod podany numer."

msgid "Створіть на сайті події файл %(f)s з таким рядком:"
msgstr "Utwórz na stronie wydarzenia plik %(f)s z tym wierszem:"

msgid "Вкажіть адресу на домені %(h)s — ми надішлемо на неї одноразове посилання. Публічні скриньки (Gmail, Ukr.net тощо) не підходять."
msgstr "Podaj adres w domenie %(h)s — wyślemy na niego jednorazowy link. Publiczne skrzynki (Gmail, Ukr.net itp.) nie są akceptowane."

msgid "Редагувати подію"
msgstr "Edytuj wydarzenie"

msgid "Зміни зʼявляться на сайті після перевірки модератором. Перенесення та скасування — розглядаються першими."
msgstr "Zmiany pojawią się na stronie po sprawdzeniu przez moderatora. Przełożenia i odwołania są rozpatrywane najpierw."

msgid "Попередні зміни ще на перевірці. Нові замінять їх."
msgstr "Poprzednie zmiany są jeszcze w weryfikacji. Nowe je zastąpią."

msgid "Дати й місце"
msgstr "Terminy i miejsce"

msgid "Додати сеанс"
msgstr "Dodaj termin"

msgid "Видалити цей сеанс"
msgstr "Usuń ten termin"

msgid "Надіслати на перевірку"
msgstr "Wyślij do weryfikacji"

msgid "Забули пароль?"
msgstr "Nie pamiętasz hasła?"

msgid "Відновлення пароля"
msgstr "Resetowanie hasła"

msgid "Вкажіть email кабінету — надішлемо посилання для нового пароля."
msgstr "Podaj e-mail konta — wyślemy link do ustawienia nowego hasła."

msgid "Новий пароль"
msgstr "Nowe hasło"

msgid "Пароль змінено"
msgstr "Hasło zmienione"

msgid "Зберегти пароль"
msgstr "Zapisz hasło"

msgid "Посилання недійсне"
msgstr "Link nieważny"

msgid "Воно вже використане або застаріло."
msgstr "Został już użyty lub wygasł."

msgid "Надіслати нове"
msgstr "Wyślij nowy"

msgid "Перевірте пошту"
msgstr "Sprawdź pocztę"

msgid "Якщо такий кабінет існує, ми надіслали лист із посиланням. Воно діє 3 дні."
msgstr "Jeśli takie konto istnieje, wysłaliśmy wiadomość z linkiem. Jest ważny 3 dni."

msgid "Кабінет створено. Ми надіслали лист — підтвердіть email за посиланням."
msgstr "Konto utworzone. Wysłaliśmy wiadomość — potwierdź e-mail, klikając link."

msgid "Спочатку підтвердіть свій email — лист у пошті, або надішліть його ще раз у кабінеті."
msgstr "Najpierw potwierdź e-mail — wiadomość jest w skrzynce lub wyślij ją ponownie z konta."

msgid "Забагато перевірок. Спробуйте пізніше."
msgstr "Zbyt wiele sprawdzeń. Spróbuj później."

msgid "Сайт підтверджено. Модератор видасть права найближчим часом."
msgstr "Strona potwierdzona. Moderator wkrótce nada uprawnienia."

msgid "Файл знайдено на іншому сайті. Він має бути на сайті самої події."
msgstr "Plik znaleziono na innej stronie. Musi być na stronie samego wydarzenia."

msgid "Файл знайдено, але код у ньому не збігається."
msgstr "Plik znaleziono, ale kod się nie zgadza."

msgid "Файл не знайдено. Перевірте адресу й спробуйте ще раз за хвилину."
msgstr "Nie znaleziono pliku. Sprawdź adres i spróbuj ponownie za minutę."

msgid "Забагато листів. Спробуйте пізніше."
msgstr "Zbyt wiele wiadomości. Spróbuj później."

msgid "Потрібна адреса на домені сайту події, не публічна пошта."
msgstr "Potrzebny jest adres w domenie strony wydarzenia, nie publiczna skrzynka."

msgid "Адреса має бути на домені %(host)s."
msgstr "Adres musi być w domenie %(host)s."

msgid "Лист надіслано. Відкрийте його й перейдіть за посиланням протягом доби."
msgstr "Wiadomość wysłana. Otwórz ją i kliknij link w ciągu doby."

msgid "Посилання недійсне або вже використане."
msgstr "Link jest nieważny lub został już użyty."

msgid "Пошту підтверджено. Модератор видасть права найближчим часом."
msgstr "Adres potwierdzony. Moderator wkrótce nada uprawnienia."

msgid "Посилання недійсне або застаріле. Надішліть лист ще раз у кабінеті."
msgstr "Link jest nieważny lub wygasł. Wyślij wiadomość ponownie z konta."

msgid "Email підтверджено."
msgstr "E-mail potwierdzony."

msgid "Лист надіслано ще раз."
msgstr "Wiadomość wysłana ponownie."

msgid "Змін немає."
msgstr "Brak zmian."

msgid "Зміни надіслано на модерацію. Після перевірки вони зʼявляться на сайті."
msgstr "Zmiany wysłane do moderacji. Pojawią się na stronie po sprawdzeniu."

msgid "Забагато запитів. Спробуйте пізніше."
msgstr "Zbyt wiele żądań. Spróbuj później."

msgid "Як підтвердите, що подія ваша"
msgstr "Jak potwierdzisz, że wydarzenie jest Twoje"

msgid "Файл на сайті події — найшвидше"
msgstr "Plik na stronie wydarzenia — najszybciej"

msgid "Лист на пошту з домену сайту події"
msgstr "Wiadomość na adres w domenie strony wydarzenia"

msgid "Перевірка модератором вручну"
msgstr "Ręczna weryfikacja przez moderatora"

msgid "Пошта на домені сайту події"
msgstr "E-mail w domenie strony wydarzenia"

msgid "Назва"
msgstr "Nazwa"

msgid "Короткий анонс"
msgstr "Krótki opis"

msgid "1–3 речення своїми словами"
msgstr "1–3 zdania własnymi słowami"

msgid "Формат"
msgstr "Format"

msgid "Посилання на реєстрацію або квитки"
msgstr "Link do rejestracji lub biletów"

msgid "До (якщо кілька днів)"
msgstr "Do (jeśli kilka dni)"

msgid "Початок"
msgstr "Początek"

msgid "Кінець"
msgstr "Koniec"

msgid "Місце проведення"
msgstr "Miejsce"

msgid "Статус"
msgstr "Status"

msgid "За планом"
msgstr "Zgodnie z planem"

msgid "Видалити"
msgstr "Usuń"

msgid "Дата закінчення раніше за початок."
msgstr "Data zakończenia jest wcześniejsza niż początek."

msgid "Подію додано у ваш кабінет"
msgstr "Wydarzenie dodano do Twojego konta"

msgid "Заявку відхилено"
msgstr "Wniosek odrzucony"

msgid "Кабінет:"
msgstr "Twoje konto:"

msgid "Тепер ви можете оновлювати подію «%(t)s» у кабінеті."
msgstr "Możesz teraz aktualizować „%(t)s” na swoim koncie."

msgid "Не вдалося підтвердити, що подія «%(t)s» ваша."
msgstr "Nie udało się potwierdzić, że „%(t)s” to Twoje wydarzenie."

msgid "Підтвердження: це ваша подія?"
msgstr "Potwierdzenie: czy to Twoje wydarzenie?"

msgid "Якщо це ви — відкрийте посилання (діє 24 години, працює один раз):"
msgstr "Jeśli to Ty — otwórz link (ważny 24 godziny, działa raz):"

msgid "Якщо ні — нічого не робіть, права ніхто не отримає."
msgstr "Jeśli nie — nic nie rób, nikt nie otrzyma uprawnień."

msgid "Хтось вказав цю адресу, щоб підтвердити, що подія «%(t)s» належить вашій організації."
msgstr "Ktoś podał ten adres, aby potwierdzić, że „%(t)s” należy do Twojej organizacji."

msgid "Щоб задати новий пароль, відкрийте посилання (діє 3 дні):"
